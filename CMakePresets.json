{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "description": "default preset",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${workspaceFolder}/build",
            "installDir": "${workspaceFolder}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug",
            "description": "debug preset",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${workspaceFolder}/build",
            "installDir": "${workspaceFolder}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}