{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "description": "default preset",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${workspaceFolder}/build",
            "installDir": "${workspaceFolder}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INSTALL_PREFIX": "${workspaceFolder}",
                "CMAKE_PREFIX_PATH":"C:/libs/SDL3-3.2.10"

            }
        },
        {
            "name": "debug",
            "description": "debug preset",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${workspaceFolder}/build",
            "installDir": "${workspaceFolder}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${workspaceFolder}",
                "CMAKE_PREFIX_PATH":"C:/libs/SDL3-3.2.10"
            }
        }
    ]
}