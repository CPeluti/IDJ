    "version": "2.0.0",
    "tasks": [
       {
        "label": "debug",
        "type": "shell",
        "command":"meson",
        "args": ["install", "-C", "builddir"],
        "group": "build",
        "dependsOn": [
            "setup"
        ],
        "presentation": {
            "reveal": "always",
        }
       },{
        "label": "setup",
        "type": "shell",
        "command":"meson",
        "args": ["setup", "builddir", "--reconfigure", "--buildtype", "debug"],
        "group": "build",
        "presentation": {
            "reveal": "always",
        }
       }

    ]
}